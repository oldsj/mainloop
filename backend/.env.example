# The single owner: the identity of every request that reaches Mainloop (it is reached only
# over the tailnet). Defaults to local-dev-user.
MAINLOOP_OWNER_ID=local-dev-user

# HMAC key for per-binding agent tokens. Required: the backend and MCP container refuse to start
# without it. DEV_MODE=true (local development only; remove it elsewhere) allows the DB password instead.
AGENT_TOKEN_KEY=
DEV_MODE=true

# kagent Agents. Workspaces and owner-started sessions run on the workspace Agents (Harness:
# sessionIdleTTL 0s, git.origins, snapshotPolicy.onQuiesce Full); children on the defaults.
# KAGENT_MAIN_AGENT=mainloop-main
# KAGENT_WORKSPACE_CLAUDE_AGENT=claude-workspace
# KAGENT_WORKSPACE_CODEX_AGENT=codex-workspace
# KAGENT_CLAUDE_AGENT=claude-subscription
# KAGENT_CODEX_AGENT=codex-subscription-https

# Preview routing: the Substrate router that previews connect through.
SUBSTRATE_ROUTER_ADDRESS=http://atenet-router.ate-system.svc.cluster.local:8081
# Domain previews are served under: http://<port>--<workspace>--preview.localhost:8001.
# In production use a domain your wildcard certificate covers (https://<domain>).
SUBSTRATE_PREVIEW_BASE_URL=http://localhost:8001

# Server
HOST=0.0.0.0
PORT=8000
