{
  "name": "mainloop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "cookie": "^0.7.0",
      "picomatch@^4.0.3": "^4.0.7",
      "rollup": "^4.59.0"
    }
  },
  "scripts": {
    "build": "node scripts/with-timeout.mjs 240 'pnpm build' -- pnpm -r build",
    "lint": "node scripts/with-timeout.mjs 120 'pnpm lint' -- pnpm -r lint",
    "format": "node scripts/with-timeout.mjs 180 'pnpm format' -- prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}
