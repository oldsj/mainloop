# Excluded. Requires retained archive verification and separate owner approval.
# Do not rename/replace the old Cluster, Database or Pooler.
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: mainloop-feature-db
  namespace: mainloop
  annotations:
    argocd.argoproj.io/sync-options: Prune=false,Delete=false
spec:
  imageName: '${VERIFIED_CNPG_VECTOR_IMAGE_AT_DIGEST}'
  instances: 1
  storage:
    size: 10Gi
    storageClass: synology-ssd
  bootstrap:
    initdb:
      database: mainloop
      owner: mainloop
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      cpu: '1'
      memory: 1Gi
---
apiVersion: postgresql.cnpg.io/v1
kind: Database
metadata:
  name: mainloop-feature-db-database
  namespace: mainloop
  annotations:
    argocd.argoproj.io/sync-options: Prune=false,Delete=false
spec:
  name: mainloop
  owner: mainloop
  cluster:
    name: mainloop-feature-db
  extensions:
    - name: vector
---
apiVersion: postgresql.cnpg.io/v1
kind: Pooler
metadata:
  name: mainloop-feature-db-pooler
  namespace: mainloop
  annotations:
    argocd.argoproj.io/sync-options: Prune=false,Delete=false
spec:
  cluster:
    name: mainloop-feature-db
  instances: 1
  type: rw
  pgbouncer:
    poolMode: session
    parameters:
      max_client_conn: '100'
      default_pool_size: '10'
      query_wait_timeout: '0'
