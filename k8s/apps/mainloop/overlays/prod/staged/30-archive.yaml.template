# Excluded. Stage 3 only: backend termination, bound Retain PV and separate
# publication approval are prerequisites. Substitute a verified pg_dump image
# digest compatible with the source server; verify UID/GID 26 and CSI fsGroup.
apiVersion: batch/v1
kind: Job
metadata:
  name: mainloop-feature-archive-dump-20261005
  namespace: mainloop
  annotations:
    argocd.argoproj.io/sync-options: Prune=false,Delete=false
    argocd.argoproj.io/sync-wave: '1'
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 1200
  template:
    metadata:
      labels:
        app.kubernetes.io/name: mainloop-feature-archive-dump
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 26
        runAsGroup: 26
        fsGroup: 26
        fsGroupChangePolicy: OnRootMismatch
      automountServiceAccountToken: false
      restartPolicy: Never
      containers:
        - name: dump
          image: '${VERIFIED_PG_ARCHIVE_IMAGE_AT_DIGEST}'
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
            seccompProfile:
              type: RuntimeDefault
          command:
            - /bin/sh
            - -ceu
            - |
              umask 077
              : "${PGHOST:?missing database host}"
              : "${PGUSER:?missing database user}"
              : "${PGPASSWORD:?missing database credential}"
              cd /backup
              archive=mainloop-feature-archive-20261005.dump
              # Refuse completed OR partial previous attempts; no automatic retries.
              for file in "$archive" "$archive.partial" "$archive.sha256"; do
                if [ -e "$file" ]; then
                  echo 'archive path already exists; refusing replay' >&2
                  exit 1
                fi
              done
              attempt=0
              until pg_isready --dbname=mainloop --timeout=5 >/dev/null 2>&1; do
                attempt=$((attempt + 1))
                if [ "$attempt" -ge 60 ]; then
                  echo 'database readiness deadline exceeded' >&2
                  exit 1
                fi
                sleep 5
              done
              if ! pg_dump --format=custom --no-password --dbname=mainloop \
                --file="$archive.partial" 2>/dev/null; then
                echo 'dump failed; preserve partial archive and stop' >&2
                exit 1
              fi
              test -s "$archive.partial"
              if ! pg_restore --file=/dev/null "$archive.partial" 2>/dev/null; then
                echo 'archive content scan failed' >&2
                exit 1
              fi
              mv "$archive.partial" "$archive"
              sha256sum "$archive" > "$archive.sha256"
              sync
              archive_size=$(wc -c < "$archive")
              echo "archive finalized: $archive_size bytes"
              cat "$archive.sha256"
          env:
            - name: PGCONNECT_TIMEOUT
              value: '5'
            - name: PGOPTIONS
              value: '-c default_transaction_read_only=on'
            - name: PGHOST
              valueFrom:
                secretKeyRef:
                  name: mainloop-db-app
                  key: host
                  optional: false
            - name: PGUSER
              valueFrom:
                secretKeyRef:
                  name: mainloop-db-app
                  key: username
                  optional: false
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: mainloop-db-app
                  key: password
                  optional: false
          volumeMounts:
            - name: archive
              mountPath: /backup
              readOnly: false
      volumes:
        - name: archive
          persistentVolumeClaim:
            claimName: mainloop-feature-archive-20261005
            readOnly: false
---
apiVersion: batch/v1
kind: Job
metadata:
  name: mainloop-feature-archive-verify-20261005
  namespace: mainloop
  annotations:
    argocd.argoproj.io/sync-options: Prune=false,Delete=false
    argocd.argoproj.io/sync-wave: '2'
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 1200
  template:
    metadata:
      labels:
        app.kubernetes.io/name: mainloop-feature-archive-verify
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 26
        runAsGroup: 26
        fsGroup: 26
        fsGroupChangePolicy: OnRootMismatch
      automountServiceAccountToken: false
      restartPolicy: Never
      containers:
        - name: verify
          image: '${VERIFIED_PG_ARCHIVE_IMAGE_AT_DIGEST}'
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
            seccompProfile:
              type: RuntimeDefault
          command:
            - /bin/sh
            - -ceu
            - |
              cd /backup
              archive=mainloop-feature-archive-20261005.dump
              attempt=0
              until [ -s "$archive.sha256" ]; do
                attempt=$((attempt + 1))
                if [ "$attempt" -ge 60 ]; then
                  echo 'completed archive deadline exceeded' >&2
                  exit 1
                fi
                sleep 5
              done
              test -s "$archive"
              test ! -e "$archive.partial"
              if ! sha256sum --check --status "$archive.sha256"; then
                echo 'archive checksum mismatch' >&2
                exit 1
              fi
              if ! pg_restore --list "$archive" >/dev/null 2>&1 || \
                ! pg_restore --file=/dev/null "$archive" 2>/dev/null; then
                echo 'retained archive content scan failed' >&2
                exit 1
              fi
              archive_size=$(wc -c < "$archive")
              echo "retained archive verified read-only: $archive_size bytes"
              cat "$archive.sha256"
          volumeMounts:
            - name: archive
              mountPath: /backup
              readOnly: true
      volumes:
        - name: archive
          persistentVolumeClaim:
            claimName: mainloop-feature-archive-20261005
            readOnly: true
