# API Configuration
VITE_API_URL=https://mainloop-api.example.com

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mainloop
DB_USER=mainloop
DB_PASSWORD=changeme

# The single owner: the identity of every request that reaches Mainloop (it is reached only
# over the tailnet). Defaults to local-dev-user.
MAINLOOP_OWNER_ID=local-dev-user

# HMAC key for per-binding agent tokens. Required: the backend and MCP container refuse to start
# without it. DEV_MODE=true (local development only; remove it elsewhere) allows the DB password instead.
AGENT_TOKEN_KEY=
DEV_MODE=true

# Preview routing: the Substrate router that previews connect through
SUBSTRATE_ROUTER_ADDRESS=http://atenet-router.ate-system.svc.cluster.local:8081
# Domain previews are served under: http://<port>--<workspace>--preview.localhost:8001.
# In production use a domain your wildcard certificate covers (https://<domain>).
SUBSTRATE_PREVIEW_BASE_URL=http://localhost:8001

# GitHub Container Registry
# Your GitHub username for pushing images to ghcr.io
GHCR_USER=yourusername

# Production Domains (for Tailscale Gateway routing)
FRONTEND_DOMAIN=mainloop.example.com
API_DOMAIN=mainloop-api.example.com
# Scheme of the frontend origin (CORS and the cross-origin write guard); http for a plain-HTTP Kind stack.
# FRONTEND_SCHEME=https
# Extra Host names the API serves, comma-separated, without ports (for example in-cluster Service names).
# The API answers 404 to any other Host. The frontend and API domains are served; loopback is allowed in dev mode.
# MAINLOOP_API_HOSTS=mainloop-backend

# Optional: Custom image tag for deployments
# IMAGE_TAG=latest
