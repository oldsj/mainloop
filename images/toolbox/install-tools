#!/bin/bash
# Installs the toolbox's binaries, each download checked against a pinned sha256 for the image's
# architecture. kubectl, talosctl and omnictl carry the same versions and checksums as
# server/Dockerfile (check-pins keeps them equal). Adding a tool means adding its pin here, its
# --version line to smoke.sh and a row to docs/specs/privileged-actions.md.
# shellcheck disable=SC2312
set -euo pipefail
arch=$(dpkg --print-architecture)
case "${arch}" in
amd64 | arm64) ;;
*)
	echo "the toolbox builds for amd64 and arm64, not ${arch}" >&2
	exit 1
	;;
esac
# pick <amd64 value> <arm64 value>
pick() { if [[ ${arch} == amd64 ]]; then echo "$1"; else echo "$2"; fi; }

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
# fetch <url> <sha256> <file>: downloads into the scratch directory and checks the digest.
fetch() {
	curl --fail --silent --show-error --location --connect-timeout 10 --max-time 300 --retry 2 "$1" -o "${scratch}/$3"
	echo "$2  ${scratch}/$3" | sha256sum --check --strict
}
# extract <file> <member> [<install name>]: installs one member of a tarball under /usr/local/bin.
extract() {
	local dir="${scratch}/x-$1"
	mkdir -p "${dir}"
	tar -xzf "${scratch}/$1" -C "${dir}"
	install -m 0555 "${dir}/$2" "/usr/local/bin/${3:-$(basename "$2")}"
}
: >/usr/local/share/toolbox/versions
record() { echo "$1=$2" >>/usr/local/share/toolbox/versions; }

# Same pins as server/Dockerfile.
