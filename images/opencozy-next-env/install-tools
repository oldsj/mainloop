#!/bin/bash
# Installs the opencozy-next toolchain, each download checked against a pinned sha256. amd64 only:
# mainloop-dev's workspaces run on linux/amd64.
set -euo pipefail
arch=$(dpkg --print-architecture)
if [[ ${arch} != amd64 ]]; then
	echo "opencozy-next-env is amd64 only, not ${arch}" >&2
	exit 1
fi
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
fetch() {
	curl --fail --silent --show-error --location --connect-timeout 10 --max-time 120 --retry 2 "$1" -o "${scratch}/$3"
	echo "$2  ${scratch}/$3" | sha256sum --check --strict
}
fetch https://go.dev/dl/go1.27.4.linux-amd64.tar.gz 7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840 go.tar.gz
tar -xzf "${scratch}/go.tar.gz" -C /usr/local
fetch https://nodejs.org/dist/v26.13.0/node-v26.13.0-linux-x64.tar.xz d28a96af6c38596f6d9d97c0ee531c13d238d757742387d1928de822d959e997 node.tar.xz
tar -xJf "${scratch}/node.tar.xz" -C /usr/local --strip-components=1
fetch https://registry.npmjs.org/@pnpm/exe.linux-x64/-/exe.linux-x64-12.18.0.tgz 679df2eedf158f639db6d1f00e713d766d0d7afc6a931bc51497a625d1e1bdf7 pnpm.tgz
mkdir "${scratch}/pnpm" && tar -xzf "${scratch}/pnpm.tgz" -C "${scratch}/pnpm"
install "${scratch}/pnpm/package/pnpm" /usr/local/bin/pnpm
fetch https://registry.npmjs.org/@agent-browser/cli-linux-x64-gnu/-/cli-linux-x64-gnu-0.43.0.tgz aa00b14ee8294edfeb1bc01bc6418cf4b7e50d75b046a9ab497c10384207383f agent-browser.tgz
mkdir "${scratch}/ab" && tar -xzf "${scratch}/agent-browser.tgz" -C "${scratch}/ab"
install "${scratch}"/ab/package/bin/agent-browser* /usr/local/bin/agent-browser
fetch https://www.postgresql.org/media/keys/ACCC4CF8.asc 0144068502a1eddd2a0280ede10ef607d1ec592ce819940991203941564e8e76 pgdg.asc
install -m 644 "${scratch}/pgdg.asc" /usr/share/keyrings/pgdg.asc
echo 'deb [signed-by=/usr/share/keyrings/pgdg.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main' >/etc/apt/sources.list.d/pgdg.list
# Package installation must not create or start a cluster.
mkdir -p /etc/postgresql-common
echo 'create_main_cluster = false' >/etc/postgresql-common/createcluster.conf
apt-get update
apt-get install -y --no-install-recommends postgresql-18=18.6-1.pgdg12+2 postgresql-client-18=18.6-1.pgdg12+2
