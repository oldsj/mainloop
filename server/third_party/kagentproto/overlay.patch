 message RevokeSessionShareResponse {}
+
+// Fork additions (oldsj/kagent mainloop-substrate-1-0), field numbers kept from v1alpha1.
+
+// A fixed model-free action over the original owned Create tuple. Repeating a
+// completed action requests a new read-only challenge; uncertain setup never reissues.
+message PrepareSessionWorkspaceRequest {
+  string session_id = 1 [(buf.validate.field).string.uuid = true];
+  string action_id = 2 [(buf.validate.field).string = {min_len: 1, max_len: 128, pattern: "^[A-Za-z0-9:._-]+$"}];
+  string create_request_id = 3 [(buf.validate.field).string = {min_len: 1, max_len: 128}];
+  string generation_id = 4 [(buf.validate.field).string.uuid = true];
+  string actor_uid = 5 [(buf.validate.field).string = {min_len: 1, max_len: 128}];
+  string prepared_revision = 6 [(buf.validate.field).string = {min_len: 1, max_len: 128}];
+  Workspace workspace = 7 [(buf.validate.field).required = true];
+  DevelopmentEnvironment development_environment = 8 [(buf.validate.field).required = true];
+  RuntimeComposition runtime_composition = 9 [(buf.validate.field).required = true];
+  string setup_profile = 10 [(buf.validate.field).string.in = "supervisor", (buf.validate.field).string.in = "child", (buf.validate.field).string.in = "agent"];
+  string setup_digest = 11 [(buf.validate.field).string = {pattern: "^[a-f0-9]{64}$"}];
+  option (buf.validate.message).cel = {
+    id: "preparation.exact_checkout"
+    message: "preparation requires a full commit SHA and named branch"
+    expression: "this.workspace.ref.matches('^[a-f0-9]{40}$') && this.workspace.branch != ''"
+  };
+}
+
+message PrepareSessionWorkspaceResponse {
+  WorkspacePreparationReceipt receipt = 1;
+}
+
+// Bounded output-only original-action evidence. A pending/uncertain classification
+// or historical=true cannot authorize current native work.
+message WorkspacePreparationReceipt {
+  PrepareSessionWorkspaceRequest original = 1;
+  string request_digest = 2;
+  string execution_id = 3;
+  string context_id = 4;
+  string atespace = 5;
+  string actor_name = 6;
+  string classification = 7;
+  string challenge_id = 8;
+  uint64 observation_sequence = 9;
+  string head = 10;
+  string branch = 11;
+  string transport_digest = 12;
+  string config_digest = 13;
+  string mcp_digest = 14;
+  string native_hook = 15;
+  google.protobuf.Timestamp effect_observed_at = 16;
+  google.protobuf.Timestamp observed_at = 17;
+  bool historical = 18;
+}
