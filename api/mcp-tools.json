      "approval": ["merge_pull_request_with_approval"]
    },
    {
      "role": "child",
      "depth": 2,
      "grant": "coordination",
      "merge_status_only": false,
      "merge_tools_enabled": false,
      "ordinary": ["report", "task_get", "task_history", "task_list", "whoami"],
      "approval": []
    },
    {
      "role": "child",
