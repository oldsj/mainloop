{
  "version": 1,
  "surfaces": {
    "ordinary": "/mcp",
    "approval": "/mcp/merge-approval"
  },
  "tools": [
    {
      "name": "whoami",
      "description": "Show your non-secret binding identity, grant status and resolved workspace scope.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      }
    },
    {
      "name": "topics",
      "description": "List topics and pending counts.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      }
    },
    {
      "name": "topic_open",
      "description": "Create or select a topic and set its status.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": ["name"],
        "type": "object"
      }
    },
    {
      "name": "note",
      "description": "Write a durable topic note.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "topic": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": ["text"],
        "type": "object"
      }
    },
    {
      "name": "decide",
      "description": "Record a topic decision.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "topic": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": ["text"],
        "type": "object"
      }
    },
    {
      "name": "pending_add",
      "description": "Record pending user intent.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "topic": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": ["text"],
        "type": "object"
      }
    },
    {
      "name": "pending_done",
      "description": "Close a pending item by id or unique prefix.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 8,
            "type": "string"
          }
        },
        "required": ["id"],
        "type": "object"
      }
    },
    {
      "name": "open_pull_request",
      "description": "Open a same-repository feature-branch PR against the current default branch. Supply a stable request_id for retries; uncertain outcomes are reconciled without resending.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "maxLength": 60000,
            "type": "string"
          },
          "branch": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "expected_sha": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "project_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["project_id", "branch", "expected_sha", "title", "body", "request_id"],
        "type": "object"
      }
    },
    {
      "name": "task_get",
      "description": "Read a scoped task and its stored projections without a native turn.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["task_id"],
        "type": "object"
      }
    },
    {
      "name": "task_list",
      "description": "List tasks visible within your persisted authority.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "parent_task_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "project_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [],
        "type": "object"
      }
    },
    {
      "name": "task_history",
      "description": "Read stored attempts, operations and reports.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["task_id"],
        "type": "object"
      }
    },
    {
      "name": "delegate",
      "description": "Create a durable task and scoped attempt. Reuse request_id for lost or uncertain responses. After a confirmed terminal blocked create, use a NEW request_id for a new create; reusing the old id returns the blocked operation. Role and tool guidance prefixes the brief.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "brief": {
            "maxLength": 16384,
            "minLength": 1,
            "type": "string"
          },
          "checkout": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "branch": {
                    "maxLength": 255,
                    "minLength": 1,
                    "type": "string"
                  },
                  "depth": {
                    "default": 0,
                    "maximum": 1000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "ref": {
                    "default": "",
                    "maxLength": 255,
                    "type": "string"
                  }
                },
                "required": ["branch"],
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "mode": {
            "enum": ["code", "coordination"],
            "type": "string"
          },
          "project_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "provider_profile_id": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "request_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "topic_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": ["request_id", "title", "brief", "mode"],
        "type": "object"
      }
    },
    {
      "name": "task_cancel",
      "description": "Request cancellation of a managed task using its current version/attempt.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "expected_attempt_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "expected_version": {
            "minimum": 1,
            "type": "integer"
          },
          "request_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "task_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["request_id", "expected_version", "expected_attempt_id", "task_id"],
        "type": "object"
      }
    },
    {
      "name": "report",
      "description": "Record progress or an explicit result claim with durable parent notification. For a blocker requiring an owner decision, use outcome=blocked and owner_action to state the specific question or choice. Routine results are stored for task reads and Activity.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "attempt_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "evidence_refs": {
            "default": [],
            "items": {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 64,
            "type": "array"
          },
          "outcome": {
            "enum": ["progress", "completed", "failed", "blocked"],
            "type": "string"
          },
          "owner_action": {
            "anyOf": [
              {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "request_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "summary": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "task_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["task_id", "attempt_id", "request_id", "summary", "outcome"],
        "type": "object"
      }
    },
    {
      "name": "prepare_pull_request_merge",
      "description": "Prepare immutable PR merge facts and required route; creates no approval card.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "expected_sha": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "pr_number": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "project_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["project_id", "pr_number", "expected_sha", "request_id"],
        "type": "object"
      }
    },
    {
      "name": "merge_pull_request",
      "description": "Merge an auto-policy unprotected PR or return an approval proposal. Reuse request_id to reconcile.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "expected_sha": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "pr_number": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "project_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["project_id", "pr_number", "expected_sha", "request_id"],
        "type": "object"
      }
    },
    {
      "name": "merge_pull_request_with_approval",
      "description": "Evaluate an exact approved merge once; Mainloop continues pending CI under that consent. Do not call again while evaluating; read get_pull_request_merge_status instead.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "proposal_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["proposal_id", "request_id"],
        "type": "object"
      }
    },
    {
      "name": "get_pull_request_merge_status",
      "description": "Read stored merge state using the original proposal_id and request_id, without approval or execution.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "proposal_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["proposal_id", "request_id"],
        "type": "object"
      }
    },
    {
      "name": "dev_lease_acquire",
      "description": "Acquire the one live-sync lease on mainloop-dev, or report your place in its FIFO queue. An idle-expired lease is taken over by the earliest queued session. A queued session must call this again within 2 minutes to keep its place.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      }
    },
    {
      "name": "dev_lease_release",
      "description": "Release the mainloop-dev lease if this session holds it.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      }
    },
    {
      "name": "dev_sync",
      "description": "Use after pushing and before open_pull_request. Syncs commit_sha (already pushed through the git push transport) into mainloop-dev, migrates its database, waits for its /health, and runs the read-only smoke check. Succeeds only when mainloop-dev is healthy and the smoke passes; any other result is failed, with the output that explains it. Requires holding the lease. Waits up to 4 minutes, then reports the state so far; retrying with the same commit_sha is safe.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "commit_sha": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          }
        },
        "required": ["commit_sha"],
        "type": "object"
      }
    },
    {
      "name": "dev_status",
      "description": "Read mainloop-dev's pod status: phase, readiness and restart counts.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      }
    }
  ],
