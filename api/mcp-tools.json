      "role": "supervisor",
      "depth": 1,
      "grant": "coordination",
      "merge_status_only": false,
      "merge_tools_enabled": false,
      "ordinary": [
        "delegate",
        "report",
        "task_cancel",
        "task_get",
        "task_history",
        "task_list",
        "whoami"
      ],
      "approval": []
    },
    {
      "role": "supervisor",
      "depth": 1,
      "grant": "coordination",
      "merge_status_only": false,
      "merge_tools_enabled": true,
      "ordinary": [
        "delegate",
