#!/bin/bash
set -euo pipefail
arch=${1-}
if [[ -z ${arch} ]]; then
	arch=$(dpkg --print-architecture)
fi
case "${arch}" in
amd64)
	node_arch=x64
	trunk_arch=x86_64
	node_sha=d28a96af6c38596f6d9d97c0ee531c13d238d757742387d1928de822d959e997
	pnpm_sha=679df2eedf158f639db6d1f00e713d766d0d7afc6a931bc51497a625d1e1bdf7
	trunk_sha=3845ff76a70cebb10e61a267ff719ffdccfa3ef6d877d51870a2c62b79603ab9
	kubectl_sha=7721f265e18709862655affba5343e85e1980639395d5754473dafaadcaa69e3
	go_sha=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
	golangci_sha=ab90aeb7b066f92a33415b638a50fe5344bbb75a0d32ad30cc248d88f81032ab
	;;
arm64)
	node_arch=arm64
	trunk_arch=arm64
	node_sha=406fe3fbde1c054adff8b297c16fdb5af6659db327c1ac8acd46b56ef1af9a92
	pnpm_sha=2e326930b9b670712df1c93849d725c85f6b897cdf9239ee724b587c50ddd5bc
	trunk_sha=cc210d2185cf95bedbec06384be6ef342bdb7dcf3ff72dd08fe0e69859516887
	kubectl_sha=420e6110e3ba7ee5a3927b5af868d18df17aae36b720529ffa4e9e945aa95450
	go_sha=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49
	golangci_sha=ee7ec5f3453d15ddf106fae5a4d6c71737712348a979d1fe9cd52ec7ea299bae
	;;
*)
	echo "Unsupported architecture: ${arch}" >&2
	exit 1
	;;
esac
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
fetch() {
	curl --fail --silent --show-error --location --connect-timeout 10 --max-time 45 --retry 1 --retry-delay 1 --retry-max-time 95 "$1" -o "${scratch}/$3"
	echo "$2  ${scratch}/$3" | sha256sum --check --strict
}
fetch "https://nodejs.org/dist/v26.13.0/node-v26.13.0-linux-${node_arch}.tar.xz" "${node_sha}" node.tar.xz
tar -xJf "${scratch}/node.tar.xz" -C /usr/local --strip-components=1
fetch "https://trunk.io/releases/1.25.0/trunk-1.25.0-linux-${trunk_arch}.tar.gz" "${trunk_sha}" trunk.tar.gz
tar -xzf "${scratch}/trunk.tar.gz" -C "${scratch}"
install "${scratch}/trunk" /usr/local/bin/trunk
fetch "https://dl.k8s.io/release/v1.34.1/bin/linux/${arch}/kubectl" "${kubectl_sha}" kubectl
install "${scratch}/kubectl" /usr/local/bin/kubectl
# Go matches server/go.mod; golangci-lint matches the version CI runs.
fetch "https://go.dev/dl/go1.27.3.linux-${arch}.tar.gz" "${go_sha}" go.tar.gz
tar -xzf "${scratch}/go.tar.gz" -C /usr/local
fetch "https://github.com/golangci/golangci-lint/releases/download/v2.14.0/golangci-lint-2.14.0-linux-${arch}.tar.gz" "${golangci_sha}" golangci.tar.gz
tar -xzf "${scratch}/golangci.tar.gz" -C "${scratch}"
install "${scratch}/golangci-lint-2.14.0-linux-${arch}/golangci-lint" /usr/local/bin/golangci-lint
# pnpm 11+ ships as a native binary; this matches packageManager in package.json.
fetch "https://registry.npmjs.org/@pnpm/exe.linux-${node_arch}/-/exe.linux-${node_arch}-12.18.0.tgz" "${pnpm_sha}" pnpm.tgz
tar -xzf "${scratch}/pnpm.tgz" -C "${scratch}"
install "${scratch}/package/pnpm" /usr/local/bin/pnpm
printf '#!/bin/sh\nexec pnpm dlx "$@"\n' >/usr/local/bin/pnpx
chmod 755 /usr/local/bin/pnpx
fetch https://www.postgresql.org/media/keys/ACCC4CF8.asc 0144068502a1eddd2a0280ede10ef607d1ec592ce819940991203941564e8e76 pgdg.asc
install -m 644 "${scratch}/pgdg.asc" /usr/share/keyrings/pgdg.asc
echo 'deb [signed-by=/usr/share/keyrings/pgdg.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main' >/etc/apt/sources.list.d/pgdg.list
# Prevent package installation from creating or starting a cluster.
mkdir -p /etc/postgresql-common
echo 'create_main_cluster = false' >/etc/postgresql-common/createcluster.conf
apt-get update
apt-get install -y --no-install-recommends postgresql-16=16.15-1.pgdg12+2 postgresql-client-16=16.15-1.pgdg12+2
